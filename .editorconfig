root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{json,asmdef,inputactions,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Preserve Unity's own serialized formatting.
[*.{unity,prefab,asset,meta,mat,anim,controller,mixer,scenetemplate}]
indent_size = 2
trim_trailing_whitespace = false
